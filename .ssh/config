# Dev servers
Host congo danube euphrates ganges indus irrawaddy amur kolyma ishim japura volga yukon zambezi aldan tunguska ural salween mekong
    User lexli

# Default settings for all hosts
Host *
    ForwardAgent yes
    AddKeysToAgent yes
    ServerAliveInterval 60
    ServerAliveCountMax 10
    # Allow legacy RSA host keys (disabled by default in newer OpenSSH)
    HostKeyAlgorithms +ssh-rsa

# macOS-only: store passphrases in Keychain
Match host * exec "test $(uname) = Darwin"
    UseKeychain yes
