#!/usr/bin/env python3
"""lsp-ready — make a PAN-OS worktree LSP-ready for a given platform/role target.

Per-platform clangd setup: different platforms/roles compile the same .c files
with different macros, so each needs its own compile_commands.json and panos.idx.
This tool builds/collects/indexes per-target artifacts under <repo>/.lsp/ and you
activate one via <repo>/.lsp/active (read by the docker-clangd wrapper).

A "target" is "<platform>-<role>" with an optional HW sub-variant suffix, e.g.
5500-cp, vm-mp, or 7500-cp-800g / 7500-dp-dpc (7500 builds cp/dp in variants).
Targets are derived from --platforms x --rpms (a platform + an RPM type yields
one or more role targets), then expanded to the real build tokens present on
disk, e.g. --platforms 5500 --rpms idpfs -> 5500-cp,5500-dp;
         --platforms 7500 --rpms idpfs -> 7500-cp-800g,7500-cp-dpc,7500-dp-800g,7500-dp-dpc.

Stages:  build -> collect -> index   (choose with --do; default: all three)
Switch the active target with --use <target>.

See design: .plans/nvim/2026-08-15_per-platform-lsp-design.md
"""

import argparse
import json
import os
import re
import subprocess
import sys
import time
from datetime import datetime, timezone
from pathlib import Path

# ---- constants -------------------------------------------------------------

STAGES = ["build", "collect", "index"]

# Fallback only; the real image is detected per-worktree from dock.mk (the kettle
# image is NOT fixed across branches/worktrees). See detect_image().
KETTLE_IMAGE_FALLBACK = "docker-kettle.af.paloaltonetworks.local/kettle-panos:13.1.0-3056"
INDEXER = "/home/lexli/.local/bin/clangd-indexer-16"
CLANGD = "/home/lexli/.local/bin/clangd-16"


def detect_image(repo: Path) -> str:
    """Resolve the kettle build image from this worktree's src/mk/config/dock.mk.

    Precedence: $PANLSP_IMAGE env override > parsed dock.mk > hard-coded fallback.
    Parses REGISTRY / DOCK_IMAGE_NAME / PAN_KETTLE_VERSION so the indexer runs in
    the SAME toolchain the build uses (clang-16 + matching sysroot/headers).
    """
    env = os.environ.get("PANLSP_IMAGE")
    if env:
        return env
    dockmk = repo / "src" / "mk" / "config" / "dock.mk"
    if not dockmk.exists():
        return KETTLE_IMAGE_FALLBACK
    vals = {}
    pat = re.compile(r"^\s*(REGISTRY|DOCK_IMAGE_NAME|PAN_KETTLE_VERSION)\s*[:?]?=\s*(.+?)\s*(?:#.*)?$")
    for line in dockmk.read_text().splitlines():
        m = pat.match(line)
        if m and m.group(1) not in vals:   # first definition wins (matches make ?=)
            vals[m.group(1)] = m.group(2).strip()
    reg, name, ver = vals.get("REGISTRY"), vals.get("DOCK_IMAGE_NAME"), vals.get("PAN_KETTLE_VERSION")
    if reg and name and ver:
        return f"{reg}/{name}:{ver}"
    return KETTLE_IMAGE_FALLBACK

# A target token is "<platform>-<role>" with an optional hardware sub-variant
# suffix, e.g. 5500-cp, vm-mp, 7500-cp-800g, 7500-dp-dpc. Some platforms (7500)
# build a role in several HW variants; each is a distinct build token / macro set.
TARGET_RE = re.compile(r"^[a-z0-9]+-[a-z]+(?:-[a-z0-9]+)*$")

# build-rpms skill: which RPM produces which roles for a platform (from SKILL.md).
# Used to translate (--platforms x --rpms) into the concrete role targets.
RPM_ROLES = {
    "idpfs": ["cp", "dp"],   # e.g. idpfs 5500 -> panos.base-5500-cp + -dp
    "mpfs": ["mp"],
    "dpfs": ["dp"],
}
ALL_ROLES = ["cp", "dp", "mp"]

# Which platforms each RPM supports. Mirrors build_rpms.py PLATFORM_SUPPORT
# (sourced from pkg/pandb_source/targets_3x.py) so we can reject invalid
# platform/rpm combos up front instead of failing deep inside a build.
PLATFORM_SUPPORT = {
    "mpfs": {
        "7500", "7000", "7000b", "5400", "5200", "3200", "1600", "1400",
        "1500", "3400", "5400f", "5500", "3500", "5500l", "800", "400",
        "500s", "500f", "220", "vm", "vmarm", "ctnr",
    },
    "dpfs": {
        "7000", "7000b", "5400", "5200", "3200", "800", "220", "vm",
        "vmarm", "ctnr",
    },
    "idpfs": {
        "7500", "5400", "1600", "1400", "1500", "3400", "5400f", "5500",
        "3500", "5500l", "400", "500s", "500f",
    },
}

# dpfs on these platforms is a cross-compiled mips/mips64 build; the x86_64
# clang-16 builtin headers we pass to the indexer will NOT match, so indexing
# those targets is best-effort. Warn rather than pretend it is correct.
DPFS_NON_X86_PLATFORMS = {"7000b", "5400", "7000", "5200", "3200", "800", "220"}


# ---- small utilities -------------------------------------------------------

class StageError(Exception):
    """A per-target stage failure that should skip the target, not abort the run."""


def die(msg, code=1):
    print(f"lsp-ready: ERROR: {msg}", file=sys.stderr)
    sys.exit(code)


def stage_die(msg):
    """Fail one target's stage without killing the whole run (caught in main)."""
    raise StageError(msg)


def info(msg):
    print(f"lsp-ready: {msg}")


def run(cmd, **kw):
    """Run a command, echoing it; raise on failure unless check=False."""
    info("+ " + " ".join(str(c) for c in cmd))
    return subprocess.run(cmd, **kw)


def run_streamed(cmd, prefix):
    """Run a command, streaming its output line-buffered with a fixed prefix.

    The build sub-tool (build_rpms.py) prints its own timestamped lines; piping
    them raw interleaves with our messages and wraps badly. Reading line-by-line
    and re-emitting with a stable "  prefix| " keeps the log readable and grep-able.
    Returns the process exit code.
    """
    info("+ " + " ".join(str(c) for c in cmd))
    p = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                         text=True, bufsize=1)
    for line in p.stdout:
        print(f"  {prefix}| {line.rstrip()}", flush=True)
    p.wait()
    return p.returncode


def find_repo(start: Path) -> Path:
    """Walk up from start to the dir containing both src/ and .git."""
    p = start.resolve()
    for cand in [p, *p.parents]:
        if (cand / "src").is_dir() and (cand / ".git").exists():
            return cand
    die(f"could not locate repo root (dir with src/ + .git) from {start}")


def parse_target(target: str):
    """'5500-cp' -> ('5500', 'cp'); '7500-cp-800g' -> ('7500', 'cp').

    Platform is the first '-' segment; role is the second. Any further segments
    are a hardware sub-variant (e.g. 800g, dpc) that does not change the role or
    the RPM used to build it. Validates the token shape.
    """
    if not TARGET_RE.match(target):
        die(f"bad target '{target}' (expected <platform>-<role>[-<variant>], e.g. 5500-cp, 7500-cp-800g)")
    parts = target.split("-")
    return parts[0], parts[1]


# ---- target paths ----------------------------------------------------------

class Target:
    def __init__(self, repo: Path, name: str):
        self.repo = repo
        self.name = name
        self.plat, self.role = parse_target(name)
        self.dir = repo / ".lsp" / "targets" / name
        self.ccjson = self.dir / "compile_commands.json"
        self.idx = self.dir / "panos.idx"
        self.cache = self.dir / "cache"
        self.meta = self.dir / "meta.json"


# ---- target resolution -----------------------------------------------------

def list_fragments(repo: Path, tgt: Target) -> list:
    """Find .compile_db fragments for this exact target token."""
    src = repo / "src"
    # Two token styles seen in the tree: panos.base-<plat>-<role> and panos-<plat>-<role>.
    tokens = [f"panos.base-{tgt.name}", f"panos-{tgt.name}"]
    found = []
    for tok in tokens:
        found += list(src.glob(f"**/.bld/{tok}/**/*.compile_db"))
    return found


def discover_tokens(repo: Path, plat: str, role: str) -> list:
    """Return the target tokens actually built on disk for a (platform, role).

    Some roles are built in several HW sub-variants (e.g. 7500 cp -> cp-800g,
    cp-dpc); each shows up as its own '.bld/panos[.base]-<plat>-<role>[-<var>]'
    directory. We scan for '<plat>-<role>' AND '<plat>-<role>-*' so both the
    plain token (5500-cp) and sub-variant tokens (7500-cp-800g) are returned.
    Result tokens are the build-token with the 'panos.base-'/'panos-' prefix
    stripped, e.g. '7500-cp-800g'. Deduplicated, sorted.
    """
    src = repo / "src"
    prefixes = ("panos.base-", "panos-")
    want = f"{plat}-{role}"
    tokens = set()
    for d in src.glob("**/.bld/*"):
        if not d.is_dir():
            continue
        n = d.name
        for pre in prefixes:
            if n.startswith(pre):
                tok = n[len(pre):]                 # e.g. 7500-cp-800g
                if tok == want or tok.startswith(want + "-"):
                    tokens.add(tok)
                break
    return sorted(tokens)


def resolve_targets(repo: Path, args) -> list:
    """Expand --platforms x roles(--rpms) into the real target tokens on disk.

    - --rpms given: roles come from the RPM_ROLES map for those RPM types.
    - --rpms omitted: use whichever roles already have build fragments on disk
      for each platform (so `--platforms 5500` just indexes what you've built).

    A single (platform, role) can map to MULTIPLE tokens when the role is built
    in HW sub-variants (7500 cp -> 7500-cp-800g, 7500-cp-dpc). We discover the
    actual '.bld' tokens instead of assuming the plain '<plat>-<role>' shape.
    If nothing is built yet but the 'build' stage is requested, we fall back to
    the plain token so the build can run (it will emit the real variants, which
    the collect/index stages then pick up).
    """
    if not args.platforms:
        die("nothing to do: pass --platforms (with optional --rpms), --use, --list or --clean")
    platforms = [p for p in args.platforms.split(",") if p]
    building = "build" in getattr(args, "_stages", []) if hasattr(args, "_stages") else False

    roles = None
    if args.rpms:
        roles = []
        rpm_list = [r.strip() for r in args.rpms.split(",") if r.strip()]
        for rpm in rpm_list:
            if rpm not in RPM_ROLES:
                die(f"unknown rpm '{rpm}' (valid: {', '.join(RPM_ROLES)})")
            for r in RPM_ROLES[rpm]:
                if r not in roles:
                    roles.append(r)
        # Reject platform/rpm combos the build system does not support, up front.
        for plat in platforms:
            for rpm in rpm_list:
                if plat not in PLATFORM_SUPPORT[rpm]:
                    ok = ", ".join(sorted(PLATFORM_SUPPORT[rpm]))
                    die(f"platform '{plat}' does not support rpm '{rpm}'.\n"
                        f"  supported platforms for {rpm}: {ok}")
                if rpm == "dpfs" and plat in DPFS_NON_X86_PLATFORMS:
                    info(f"WARNING: dpfs on '{plat}' is a mips/mips64 cross build; "
                         f"the indexer uses x86_64 clang builtins, so the {plat}-dp "
                         f"index may be inaccurate.")

    targets = []
    for plat in platforms:
        wanted = roles if roles is not None else ALL_ROLES
        found_any = False
        for r in wanted:
            toks = discover_tokens(repo, plat, r)
            if toks:
                found_any = True
                for tok in toks:
                    if tok not in targets:
                        targets.append(tok)
            elif roles is not None and building:
                # Not built yet, but the user asked to build this role: keep the
                # plain token as a placeholder (build runs per plat+rpm in phase 1;
                # collect/index re-resolve to the emitted variants afterwards).
                tok = f"{plat}-{r}"
                if tok not in targets:
                    targets.append(tok)
        if roles is None and not found_any:
            die(f"no build fragments found for platform '{plat}'; "
                f"specify --rpms to build (e.g. --rpms idpfs) and --do build")
    return targets


# ---- stages ----------------------------------------------------------------

def run_build(repo: Path, plat: str, rpm: str):
    """Invoke build-rpms once for a platform+RPM. One RPM emits every role (and
    every HW sub-variant) it contains, so building is keyed by (plat, rpm), not
    by target token. A build failure is fatal (nothing downstream can proceed)."""
    build_cmd = [
        "python3",
        str(repo / ".agents/skills/build-rpms/build_rpms.py"),
        "--platform", plat, "--rpm", rpm,
    ]
    rc = run_streamed(build_cmd, prefix=f"build:{plat}-{rpm}")
    if rc != 0:
        die(f"[build] build-rpms failed for platform={plat} rpm={rpm}")
    info(f"[build] platform={plat} rpm={rpm} done")


def stage_collect(repo: Path, tgt: Target, args):
    """Filter fragments to THIS target, de-dup by 'file', write compile_commands.json."""
    frag = list_fragments(repo, tgt)
    if not frag:
        stage_die(f"[collect] no .compile_db fragments for {tgt.name}; build it first "
                  f"(e.g. --platforms {tgt.plat} --rpms <rpm> --do build) "
                  f"or check the platform-role token")
    entries = []
    for f in frag:
        try:
            txt = f.read_text().strip().rstrip(",")
            if txt:
                entries.append(json.loads(txt))
        except json.JSONDecodeError as e:
            info(f"[collect] skip {f}: {e}")

    # De-dup by 'file' (guard rail): each .c must appear once for this target.
    seen = {}
    dupes = 0
    for e in entries:
        key = e.get("file")
        if key in seen:
            dupes += 1
            continue
        seen[key] = e
    if dupes:
        info(f"[collect] WARNING: dropped {dupes} duplicate 'file' entries within {tgt.name}")

    tgt.dir.mkdir(parents=True, exist_ok=True)
    tgt.ccjson.write_text(json.dumps(list(seen.values()), indent=2))
    info(f"[collect] wrote {len(seen)} entries -> {tgt.ccjson}")


def stage_index(repo: Path, tgt: Target, args):
    """Run clangd-indexer-16 in-container: compile_commands.json -> panos.idx."""
    if not tgt.ccjson.exists():
        stage_die(f"[index] {tgt.ccjson} missing; run the 'collect' stage first")
    tgt.dir.mkdir(parents=True, exist_ok=True)
    # Clear this target's background cache before re-indexing. clangd's
    # --background-index writes shards under $TDIR/cache/clangd/index/ (see
    # docker-clangd). A rebuilt panos.idx does NOT invalidate those shards, so
    # stale ones can shadow the fresh static index (design doc: the 3 layers —
    # compile_commands.json, panos.idx, cache — must move together). Wiping the
    # cache here guarantees a rebuild yields a clean index; clangd repopulates
    # it lazily on next open.
    if tgt.cache.exists():
        import shutil
        shutil.rmtree(tgt.cache, ignore_errors=True)
        info(f"[index] cleared stale background cache {tgt.cache}")
    tgt.cache.mkdir(parents=True, exist_ok=True)
    # clangd-indexer drives clang semantics even for gcc/cc compile commands, so
    # it must be told where the clang-16 builtin headers live (stddef.h, stdarg.h,
    # etc.). Without this, every TU whose command is gcc/cc fails with
    # "'stddef.h' file not found". The resource-include dir is fixed in the kettle
    # image at /usr/lib64/clang/16/include (matches clangd-16 / clangd-indexer-16).
    inner = (
        f"{INDEXER} --executor=all-TUs "
        f"--extra-arg=-isystem --extra-arg=/usr/lib64/clang/16/include "
        f"{tgt.ccjson} > {tgt.idx}"
    )
    cmd = [
        "docker", "run", "--rm",
        "--user", f"{os.getuid()}:{os.getgid()}",
        "-v", "/home/lexli:/home/lexli",
        "-w", str(tgt.dir),
        "-e", "HOME=/home/lexli",
        "-e", "PATH=/home/lexli/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
        detect_image(repo),
        "bash", "-c", inner,
    ]
    t0 = time.time()
    r = run(cmd)
    if r.returncode != 0 or not tgt.idx.exists() or tgt.idx.stat().st_size == 0:
        stage_die(f"[index] indexer failed for {tgt.name}")
    info(f"[index] built {tgt.idx} ({tgt.idx.stat().st_size} bytes) in {time.time()-t0:.0f}s")


def write_meta(repo: Path, tgt: Target):
    try:
        head = subprocess.check_output(
            ["git", "-C", str(repo), "rev-parse", "--short", "HEAD"],
            text=True).strip()
    except Exception:
        head = "unknown"
    n = 0
    if tgt.ccjson.exists():
        try:
            n = len(json.loads(tgt.ccjson.read_text()))
        except Exception:
            pass
    tgt.meta.write_text(json.dumps({
        "target": tgt.name,
        "entries": n,
        "git_head": head,
        "built_at": datetime.now(timezone.utc).isoformat(),
        "indexer": os.path.basename(INDEXER),
    }, indent=2))


def activate(repo: Path, name: str):
    active = repo / ".lsp" / "active"
    active.parent.mkdir(parents=True, exist_ok=True)
    active.write_text(name + "\n")
    info(f"[use] .lsp/active -> {name}")
    info("done. In nvim run :LspRestart (or reopen) to load the active target.")


# ---- top-level commands ----------------------------------------------------

def cmd_list(repo: Path):
    targets_dir = repo / ".lsp" / "targets"
    active = ""
    af = repo / ".lsp" / "active"
    if af.exists():
        active = af.read_text().strip()
    if not targets_dir.exists():
        print("no targets built yet (run: lsp-ready --platforms <plat> --rpms <rpm>)")
        if not active:
            print("active: NONE (clangd will use fallback flags)")
        return
    for d in sorted(targets_dir.iterdir()):
        if not d.is_dir():
            continue
        mark = " *ACTIVE*" if d.name == active else ""
        has_idx = (d / "panos.idx").exists()
        print(f"  {d.name}{mark}  index={'yes' if has_idx else 'NO'}")
    if not active:
        print("active: NONE (clangd will use fallback flags — run lsp-ready --use <target>)")
    elif not (targets_dir / active).exists():
        print(f"active: {active} (WARNING: target dir missing)")


def cmd_clean(repo: Path, name: str):
    import shutil
    base = repo / ".lsp" / "targets"
    if name == "all":
        if not base.exists() or not any(base.iterdir()):
            info("nothing to clean: no targets built")
            return
        for d in sorted(base.iterdir()):
            if d.is_dir():
                shutil.rmtree(d)
                info(f"removed {d}")
        return
    d = base / name
    if d.exists():
        shutil.rmtree(d)
        info(f"removed {d}")
    else:
        info(f"nothing to clean: {d} does not exist")


def main():
    def fmt(prog):
        # Wide help column so each option's description stays on one line.
        return argparse.RawTextHelpFormatter(prog, max_help_position=40, width=100)

    ap = argparse.ArgumentParser(
        prog="lsp-ready",
        description="Make a PAN-OS worktree LSP-ready for platform/role targets.",
        formatter_class=fmt)
    ap.add_argument("--platforms", metavar="<7500,5500,..>",
                    help="comma for multiple")
    ap.add_argument("--rpms", metavar="<mpfs,dpfs,idpfs>",
                    help="comma for multiple")
    ap.add_argument("--do", dest="do", metavar="<build,collect,index,all>",
                    help="comma for multiple; 'all' = build,collect,index (default)")
    ap.add_argument("--use", metavar="<target>",
                    help="use this target (e.g. 5500-dp, 7500-mp)")
    ap.add_argument("--list", action="store_true",
                    help="list ready targets and the active one")
    ap.add_argument("--clean", metavar="<target|all>",
                    help="remove cached artifacts for target, or 'all'")
    ap.add_argument("--dry-run", action="store_true", help="")

    # No arguments at all -> print help and exit (don't fall through to the
    # build-stage guard, which would emit a confusing --rpms error).
    if len(sys.argv) == 1:
        ap.print_help()
        return

    args = ap.parse_args()

    repo = find_repo(Path.cwd())

    # Simple sub-commands first.
    if args.list:
        return cmd_list(repo)
    if args.clean:
        return cmd_clean(repo, args.clean)
    if args.use:
        tgt = Target(repo, args.use)  # validates shape
        if not tgt.dir.exists():
            die(f"--use {args.use}: target not built "
                f"(run: lsp-ready --platforms {tgt.plat} --rpms <rpm>)")
        return activate(repo, tgt.name)

    # Stage selection: default is all three (build, collect, index).
    # 'all' is an alias for every stage.
    if args.do:
        req = [s.strip() for s in args.do.split(",") if s.strip()]
        if "all" in req:
            stages = list(STAGES)
        else:
            for s in req:
                if s not in STAGES:
                    die(f"unknown stage '{s}' (valid: {', '.join(STAGES)}, all)")
            stages = [s for s in STAGES if s in req]  # canonical order
    else:
        stages = list(STAGES)

    # The build stage needs to know which RPM to build for each role, so --rpms
    # is required whenever 'build' is in the stage list.
    if "build" in stages and not args.rpms:
        die("--do includes 'build' but --rpms not given "
            "(e.g. --rpms idpfs). Use --do collect,index to skip building.")

    args._stages = stages  # lets resolve_targets keep plain fallback tokens for building

    # Phase 1: build (once per platform+RPM; one RPM emits all its role variants).
    if "build" in stages:
        build_plan = []
        for plat in [p for p in args.platforms.split(",") if p]:
            for rpm in [r.strip() for r in args.rpms.split(",") if r.strip()]:
                if (plat, rpm) not in build_plan:
                    build_plan.append((plat, rpm))
        if args.dry_run:
            info(f"repo: {repo}")
            info(f"build plan (platform,rpm): {build_plan}")
        for plat, rpm in build_plan:
            if args.dry_run:
                continue
            run_build(repo, plat, rpm)

    # Phase 2: re-resolve to the REAL tokens on disk (build may have just emitted
    # HW sub-variants like 7500-cp-800g), then collect/index each independently.
    targets = resolve_targets(repo, args)

    if args.dry_run:
        info(f"repo: {repo}")
        info(f"targets: {targets}")
        info(f"stages: {stages}")
        return

    post = [st for st in stages if st in ("collect", "index")]
    if not post:
        return

    stage_fns = {"collect": stage_collect, "index": stage_index}
    failed = []
    for name in targets:
        tgt = Target(repo, name)
        info(f"=== target {name} : stages {post} ===")
        try:
            for st in post:
                stage_fns[st](repo, tgt, args)
            write_meta(repo, tgt)
        except StageError as e:
            info(f"[skip] {name}: {e}")
            failed.append((name, str(e)))

    failed_names = {n for n, _ in failed}
    ok = [t for t in targets if t not in failed_names]
    info(f"summary: {len(ok)} ok, {len(failed)} failed (ok: {', '.join(ok) or '-'})")
    if failed:
        for n, e in failed:
            info(f"  FAILED {n}: {e}")
        sys.exit(1)


if __name__ == "__main__":
    main()
