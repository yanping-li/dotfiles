#!/bin/bash
# docker-clangd — run version-matched clangd-16 INSIDE the build container,
# seeded with a per-TARGET prebuilt index (panos.idx).
#
# Per-platform LSP: the active target is named in <repo>/.lsp/active (written by
# `lsp-panos`). This wrapper reads it and points clangd at that target's
# compile_commands.json dir, panos.idx, and its own background cache.
#
# If no target is active, clangd still starts but falls back to flag-less
# parsing (WRONG #ifdef view). A loud banner is printed so it is never silent.
#
# --user makes the container process run as the host user so .cache shards are
# owned by you (not root).

set -euo pipefail

# --- locate the repo root (dir containing src/ + .git), walking up from PWD ---
find_repo() {
  local d="$PWD"
  while [ "$d" != "/" ]; do
    if [ -d "$d/src" ] && [ -e "$d/.git" ]; then
      echo "$d"; return 0
    fi
    d="$(dirname "$d")"
  done
  return 1
}

REPO="${PANLSP_REPO:-$(find_repo || true)}"
if [ -z "${REPO:-}" ]; then
  # Fallback to the legacy hard-coded worktree so behavior never fully breaks.
  REPO="/home/lexli/pan/wte"
fi

# --- detect the kettle build image from the worktree's build config ---------
# The image is NOT fixed across branches/worktrees. src/mk/config/dock.mk is the
# authoritative source: REGISTRY / DOCK_IMAGE_NAME / PAN_KETTLE_VERSION. Parse
# them so clangd always runs in the SAME toolchain the build uses. Order of
# precedence: $PANLSP_IMAGE override > parsed from dock.mk > hard-coded fallback.
detect_image() {
  local dockmk="$REPO/src/mk/config/dock.mk"
  local fallback="docker-kettle.af.paloaltonetworks.local/kettle-panos:13.1.0-3056"
  [ -n "${PANLSP_IMAGE:-}" ] && { echo "$PANLSP_IMAGE"; return; }
  [ -f "$dockmk" ] || { echo "$fallback"; return; }
  local mkval reg name ver
  mkval() { grep -E "^[[:space:]]*$1[[:space:]]*[:?]?=" "$dockmk" | head -1 \
              | sed -E 's/.*=[[:space:]]*//; s/[[:space:]]+#.*//; s/[[:space:]]+$//'; }
  reg="$(mkval REGISTRY)"; name="$(mkval DOCK_IMAGE_NAME)"; ver="$(mkval PAN_KETTLE_VERSION)"
  if [ -n "$reg" ] && [ -n "$name" ] && [ -n "$ver" ]; then
    echo "$reg/$name:$ver"
  else
    echo "$fallback"
  fi
}
KETTLE_IMAGE="$(detect_image)"
echo "docker-clangd: kettle image: $KETTLE_IMAGE" >&2

ACTIVE_FILE="$REPO/.lsp/active"
TARGET=""
[ -f "$ACTIVE_FILE" ] && TARGET="$(tr -d '[:space:]' < "$ACTIVE_FILE")"

# --- resource-dir: point clangd at ITS OWN container's builtin headers --------
# clangd-16 here is the HOST binary (/home/lexli/.local/bin/clangd-16), bind-mounted
# into the container and run from that host path. Clang normally auto-detects its
# resource dir (stddef.h, stdarg.h, etc.) relative to its OWN binary's install
# location — which fails here, since the host path has no relationship to the
# container's real /usr/lib64/clang/16 tree. Symptom when this is missing: system
# headers like <string.h> fail mid-include ("'stddef.h' file not found"), which
# then cascades (e.g. NULL becomes "undeclared identifier") and silently breaks
# gd/hover for everything after that point in the file — while the SAME symbol
# still resolves fine via workspace-symbol search (name lookup, not tied to this
# file's own broken AST). lsp-panos's OFFLINE indexer already works around this
# exact issue (see stage_index()'s --extra-arg=-isystem); this wrapper never had
# the same fix. Detected per-image (not hardcoded) since different branches use
# different kettle images with potentially different clang installs.
RESOURCE_DIR="$(docker run --rm "$KETTLE_IMAGE" clang-16 -print-resource-dir 2>/dev/null || true)"

# --- derive clangd flags from the active target (or fall back) ----------------
CLANGD_ARGS=(--background-index)
[ -n "$RESOURCE_DIR" ] && CLANGD_ARGS+=("--resource-dir=$RESOURCE_DIR")

if [ -n "$TARGET" ] && [ -d "$REPO/.lsp/targets/$TARGET" ]; then
  TDIR="$REPO/.lsp/targets/$TARGET"
  mkdir -p "$TDIR/cache"
  echo "docker-clangd: clangd target: $TARGET" >&2
  CLANGD_ARGS+=(--compile-commands-dir="$TDIR")
  [ -f "$TDIR/panos.idx" ] && CLANGD_ARGS+=(--index-file="$TDIR/panos.idx")
  # per-target background cache: point HOME at the target so .cache/clangd
  # shards land under $TDIR/cache and cannot contaminate other targets.
  CACHE_HOME="$TDIR/cache"
else
  echo "docker-clangd: clangd target: NONE (fallback flags — run 'lsp-panos --platforms <p>' then 'lsp-panos --use <target>')" >&2
  CACHE_HOME="/home/lexli"
fi

# Named so we can force-stop THIS container on any exit path. nvim's graceful
# LSP shutdown (shutdown+exit over stdio) can race its own process exit — in
# testing, nvim's process fully exited while the container was still up
# minutes later, so the exit-notification handshake alone is NOT reliable.
# ssh/tmux drops deliver SIGHUP rather than any handshake at all. Either way
# the container can outlive nvim indefinitely, still burning CPU on
# --background-index (see the clangd-survives-nvim-exit investigation in
# dotfiles-ai/.plans/nvim/TODO.md). Not exec'd, so this script keeps its own
# PID (instead of being replaced by docker's) and can trap signals/exit to
# clean up regardless of how it's told to stop.
CONTAINER_NAME="docker-clangd-$$"
PARENT_PID="$PPID"  # nvim's pid: it execs this script directly as the LSP job

cleanup() {
  docker stop -t 2 "$CONTAINER_NAME" >/dev/null 2>&1 || true
  [ -n "${WATCHER_PID:-}" ] && kill "$WATCHER_PID" 2>/dev/null || true
}
trap cleanup EXIT INT TERM HUP

# Orphan watchdog: don't rely on nvim telling us to stop at all (the graceful
# handshake races nvim's own exit, per above). Instead poll whether our
# original parent (nvim) is still alive, and force-stop the container the
# moment it isn't — this covers every exit path uniformly, including nvim
# crashing or vanishing without any notification or signal reaching us.
(
  while kill -0 "$PARENT_PID" 2>/dev/null; do
    sleep 2
  done
  docker stop -t 2 "$CONTAINER_NAME" >/dev/null 2>&1
) &
WATCHER_PID=$!

docker run --rm -i \
  --name "$CONTAINER_NAME" \
  --user "$(id -u):$(id -g)" \
  -v /home/lexli:/home/lexli \
  -w "$REPO/src" \
  -e HOME="$CACHE_HOME" \
  -e USER="lexli" \
  -e PATH="/home/lexli/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin" \
  "$KETTLE_IMAGE" \
  /home/lexli/.local/bin/clangd-16 \
    "${CLANGD_ARGS[@]}" \
    "$@" <&0 &
# <&0 above is required: with job control off (the default for a non-interactive
# script), bash silently redirects a backgrounded command's stdin from /dev/null
# UNLESS the command itself specifies a stdin redirection — without it clangd
# sees an immediately-broken stdin ("Transport error: Input/output error").
DOCKER_PID=$!
wait "$DOCKER_PID"
